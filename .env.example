# --- Front (Vite): exposed to the browser ---
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
# Optional: MapLibre style (default: OpenFreeMap positron, no key needed)
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Public Cloudflare Turnstile key (report form). Missing = no captcha (dev only).
VITE_TURNSTILE_SITE_KEY=<Turnstile site key>

# --- Import scripts (local only, never expose) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# --- Edge Function secrets (supabase secrets set ...) ---
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.
# Google AI Studio API key used for extraction.
GEMINI_API_KEY=<Gemini API key>
# Model (default: gemini-3.5-flash-lite).
GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback models when the main one is saturated or closed for this account.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash
# Thinking budget in tokens (billed as output). 0 turns it off; -1 or unset = the model's default.
# A model that rejects the setting is called again without it.
# GEMINI_THINKING_BUDGET=0
# Media analysis and reanalysis: thinking off by default (0); -1 = the model's default.
# MEDIA_THINKING_BUDGET=0
# REANALYZE_THINKING_BUDGET=0
# Max characters of each item sent to extraction (default 6000, never reached in practice).
# Lower it only after `npm run eval:truncation` shows nothing is lost.
# EXTRACTION_TEXT_CHARS=2000
# Collection tuning (defaults):
# COLLECT_SOURCES_PER_WORKER=4
# COLLECT_WORKER_CONCURRENCY=4
# COLLECT_MAX_SOURCES_PER_RUN=80
# COLLECT_ITEMS_PER_GEMINI_CALL=60
# Secret shared with pg_cron (x-collect-secret header). Generate: openssl rand -hex 32
COLLECT_SECRET=<random secret>
# Cloudflare Turnstile secret key, checked by submit-report.
TURNSTILE_SECRET_KEY=<Turnstile secret key>
# Minimum certainty to create a report: haute | moyenne | faible
COLLECT_MIN_CERTAINTY=moyenne
