# --- Front (Vite) : exposées au navigateur ---
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé anon / publishable>
# Optionnel : style de carte MapLibre (défaut : OpenFreeMap positron, sans clé)
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Clé publique Cloudflare Turnstile (formulaire de signalement). Absente = pas de captcha (dev).
VITE_TURNSTILE_SITE_KEY=<clé site Turnstile>

# --- Script d'import (local uniquement, ne jamais exposer) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<clé service role>

# --- Secrets des Edge Functions (supabase secrets set ...) ---
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement par Supabase.
# Clé API Google AI Studio pour l'extraction.
GEMINI_API_KEY=<clé Gemini>
# Modèle (défaut gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash
# Secret partagé avec pg_cron (en-tête x-collect-secret). Générer : openssl rand -hex 32
COLLECT_SECRET=<secret aléatoire>
# Clé secrète Cloudflare Turnstile, vérifiée par submit-report.
TURNSTILE_SECRET_KEY=<clé secrète Turnstile>
# Niveau de certitude minimal pour créer un signal : haute | moyenne | faible
COLLECT_MIN_CERTAINTY=moyenne
