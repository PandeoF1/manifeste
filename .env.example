# Manifeste v2: deployment facts and secrets. AI models and prompts default to the production
# setup in packages/ai (src/config.ts); the variables below only override them.
# Copy to .env (git-ignored) for local development.

# --- Server (apps/server) ---
# api = HTTP + WebSocket, worker = jobs, all = both (dev, staging, previews)
ROLE=all
PORT=3000
DATABASE_URL=postgres://postgres@localhost:54329/manifeste_dev
# Dev/staging/previews apply migrations at boot; production runs the one-shot migrate service.
MIGRATE_ON_BOOT=true
PUBLIC_URL=http://localhost:3000
# openssl rand -hex 32
AUTH_SECRET=<random secret, 32+ chars>
LOG_LEVEL=info
# Where photos are stored (originals are deleted after moderation or 48 h).
DATA_DIR=./data
# Cloudflare Turnstile secret for the report form. Required in production; empty skips the check in dev.
# TURNSTILE_SECRET_KEY=

# --- AI (the worker needs a Gemini key in production; without one AI is off in dev) ---
# GEMINI_API_KEY=
# JEV_API_KEY=            # second-opinion judge; without it the judge is off
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash
# GEMINI_THINKING_BUDGET=0
# GEMINI_PROMPT=v1        # v1 | v1-strict | v1-nature | v1-strict-nature
# AI_ENABLED=false        # kill switch: every AI call is refused
# AI_DAILY_BUDGET_USD=5   # estimated spend per UTC day above which calls are refused

# --- Observability (optional): Grafana Cloud OTLP gateway ---
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instanceId:token>
# OTEL_SERVICE_NAME=manifeste

# --- PR previews only (see docs/ops/coolify.md) ---
# PREVIEW_DATABASE_SERVER_URL=postgres://preview:<password>@preview-db:5432/postgres
# PREVIEW_ID=<pull request number>

# --- Front (Vite, exposed to the browser) ---
# Still read by the SPA until it moves to the Eden client (phase 6).
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
VITE_TURNSTILE_SITE_KEY=<Turnstile site key>
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
