{
  "name": "manifeste",
  "private": true,
  "version": "0.2.0",
  "description": "Live map of blocked high schools and universities in France, with a source for every report.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PandeoF1/manifeste.git"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "bench",
    "e2e"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@manifeste/server' --filter '@manifeste/web' dev",
    "dev:web": "bun run --filter '@manifeste/web' dev",
    "dev:api": "bun run --filter '@manifeste/server' dev",
    "test:e2e": "bun run --filter '@manifeste/e2e' test:e2e",
    "build": "bun run --filter '@manifeste/web' build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "@types/bun": "^1.4.3"
  },
  "overrides": {
    "@sinclair/typebox": "0.34.52"
  }
}
